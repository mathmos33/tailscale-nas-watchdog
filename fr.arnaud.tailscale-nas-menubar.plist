<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>fr.arnaud.tailscale-nas-menubar</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/Applications/TailscaleNAS.app/Contents/MacOS/TailscaleNAS</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/TailscaleNAS/menubar.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/TailscaleNAS/menubar.err</string>
</dict>
</plist>
